{
  "version": 1,
  "hooks": {
    "sessionStart": [
      { "command": "./hooks/session-start.sh", "timeout": 900 }
    ],
    "sessionEnd": [
      { "command": "./hooks/mark-activity.sh", "timeout": 10 }
    ],
    "beforeMCPExecution": [
      { "command": "./hooks/gate.sh", "matcher": "mark_publish|mark_append", "timeout": 20 },
      { "command": "./hooks/promote-nudge.sh", "matcher": "mark_publish", "timeout": 20 }
    ],
    "afterMCPExecution": [
      { "command": "./hooks/mark-activity.sh", "matcher": "mark_publish|mark_append", "timeout": 10 }
    ],
    "afterFileEdit": [
      { "command": "./hooks/mark-activity.sh", "timeout": 10 }
    ],
    "stop": [
      { "command": "./hooks/stop-nudge.sh", "timeout": 20, "loop_limit": 1 }
    ]
  }
}
