{
  "version": 1,
  "hooks": {
    "sessionStart": [
      { "command": "./hooks/session-start.sh", "timeout": 600 }
    ],
    "beforeMCPExecution": [
      { "command": "./hooks/gate.sh", "matcher": "mark_publish|mark_append|mark_archive|mark_curate|mark_promote|mark_graph_publish", "timeout": 20, "failClosed": true }
    ]
  }
}
