{
  "name": "demarkus-pi-knowledge",
  "version": "0.5.78",
  "description": "Join an organizational demarkus knowledge system from the Pi coding agent. Registers the broker as an OAuth MCP server, steers sessions to the shared catalog, and enforces publishing policy. Runs no local server; a shared helper binary provides gates and guidance.",
  "author": "latebit",
  "homepage": "https://github.com/latebit-io/demarkus/tree/main/plugins/pi-knowledge",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-skill",
    "demarkus",
    "knowledge",
    "markdown",
    "shared-knowledge",
    "coding-agent"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills/knowledge-promote/SKILL.md"
    ]
  },
  "files": [
    "src",
    "scripts",
    "skills",
    "commands",
    "context",
    "README.md",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.79.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
