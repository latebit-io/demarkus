# Keep the build context minimal so unrelated edits don't invalidate
# Docker's layer cache and `docker build` stays fast. Applies to every
# image build at repo root (server/, broker/, agent/ Dockerfiles all use
# `.` as context).
.git/
.github/
docs/
deploy/
plugins/
trials/
**/bin/
**/*.test
**/*.out
**/coverage.*
**/.mark/
.dockerignore
*.md
